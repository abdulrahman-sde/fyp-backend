// HireFlow - Production Database Schema
// Stack: PostgreSQL + Prisma ORM
// Conventions: snake_case columns, UUID PKs, soft-delete via deleted_at,
//              all timestamps in UTC, immutable audit fields never updated.

generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum Role {
    APPLICANT
    RECRUITER
}

enum JobStatus {
    DRAFT
    PUBLISHED
    CLOSED
    ARCHIVED
}

enum JobType {
    FULL_TIME
    PART_TIME
    CONTRACT
    INTERNSHIP
    REMOTE
}

enum ExperienceLevel {
    ENTRY
    MID
    SENIOR
    LEAD
    EXECUTIVE
}

enum ApplicationStatus {
    APPLIED // just submitted
    SCREENING // resume under review
    SHORTLISTED // passed resume screening, awaiting interview
    INTERVIEWED // completed AI interview
    OFFERED // final offer extended (future scope, kept for pipeline)
    REJECTED
    WITHDRAWN // applicant pulled out
}

enum InterviewStatus {
    PENDING // link sent, not started
    IN_PROGRESS
    COMPLETED
    EXPIRED // deadline + 24h grace passed without completion
    CANCELLED
}

enum VideoRecordingStatus {
    NOT_STARTED
    RECORDING
    PROCESSING
    AVAILABLE
    FAILED
}

enum AuditAction {
    CREATE
    UPDATE
    DELETE
    LOGIN
    LOGOUT
    FILE_UPLOAD
    FILE_DELETE
    SCORE_CALCULATED
}

// ---------------------------------------------------------------------------
// USERS — single table for all roles (discriminator: role)
// Splitting into separate tables adds joins without meaningful benefit here.
// ---------------------------------------------------------------------------

model User {
    id         String    @id @default(uuid()) @db.Uuid
    email      String    @unique @db.VarChar(320)
    password   String    @db.VarChar(256) // bcrypt hash
    role       Role
    is_active  Boolean   @default(true)
    created_at DateTime  @default(now()) @db.Timestamptz
    updated_at DateTime  @updatedAt @db.Timestamptz
    deleted_at DateTime? @db.Timestamptz // soft delete

    // Relations
    applicant_profile ApplicantProfile?
    recruiter_profile RecruiterProfile?
    refresh_tokens RefreshToken[]
    audit_logs     AuditLog[]

    @@index([email])
    @@index([role])
    @@index([deleted_at])
    @@map("users")
}

// ---------------------------------------------------------------------------
// REFRESH TOKENS — stored server-side to allow invalidation (logout, revoke)
// ---------------------------------------------------------------------------

model RefreshToken {
    id         String    @id @default(uuid()) @db.Uuid
    user_id    String    @db.Uuid
    token_hash String    @unique @db.VarChar(256) // SHA-256 of raw token
    expires_at DateTime  @db.Timestamptz
    revoked_at DateTime? @db.Timestamptz
    created_at DateTime  @default(now()) @db.Timestamptz
    ip_address String?   @db.Inet
    user_agent String?   @db.VarChar(512)

    user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

    @@index([user_id])
    @@index([expires_at])
    @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// APPLICANT PROFILE
// ---------------------------------------------------------------------------

model ApplicantProfile {
    id              String   @id @default(uuid()) @db.Uuid
    user_id         String   @unique @db.Uuid
    first_name      String   @db.VarChar(100)
    last_name       String   @db.VarChar(100)
    phone           String?  @db.VarChar(30)
    location        String?  @db.VarChar(200)
    headline        String?  @db.VarChar(300) // one-liner shown on profile
    interests       String[] @db.VarChar(100) // array of interest tags
    onboarding_done Boolean  @default(false)
    created_at      DateTime @default(now()) @db.Timestamptz
    updated_at      DateTime @updatedAt @db.Timestamptz

    user         User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
    resume       Resume?
    applications Application[]

    @@index([user_id])
    @@map("applicant_profiles")
}

// ---------------------------------------------------------------------------
// RESUME — one per applicant; raw text used directly in AI prompts at analysis time
// ---------------------------------------------------------------------------

model Resume {
    id              String   @id @default(uuid()) @db.Uuid
    applicant_id    String   @unique @db.Uuid
    file_name       String   @db.VarChar(255)
    file_key        String   @db.VarChar(512) // S3 / object-store key
    file_size_bytes Int
    mime_type       String   @db.VarChar(100) // application/pdf or docx
    raw_text        String
    uploaded_at     DateTime @default(now()) @db.Timestamptz

    applicant ApplicantProfile @relation(fields: [applicant_id], references: [id], onDelete: Cascade)

    @@index([applicant_id])
    @@map("resumes")
}

// ---------------------------------------------------------------------------
// RECRUITER PROFILE
// ---------------------------------------------------------------------------

model RecruiterProfile {
    id         String   @id @default(uuid()) @db.Uuid
    user_id    String   @unique @db.Uuid
    first_name String   @db.VarChar(100)
    last_name  String   @db.VarChar(100)
    phone      String?  @db.VarChar(30)
    company_id String   @db.Uuid
    job_title  String?  @db.VarChar(150)
    created_at DateTime @default(now()) @db.Timestamptz
    updated_at DateTime @updatedAt @db.Timestamptz

    user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
    company Company @relation(fields: [company_id], references: [id])
    jobs    Job[]

    @@index([user_id])
    @@index([company_id])
    @@map("recruiter_profiles")
}

// ---------------------------------------------------------------------------
// COMPANY — normalized so multiple recruiters can share one company
// ---------------------------------------------------------------------------

model Company {
    id         String   @id @default(uuid()) @db.Uuid
    name       String   @db.VarChar(255)
    website    String?  @db.VarChar(512)
    industry   String?  @db.VarChar(100)
    size       String?  @db.VarChar(50) // "1-10", "11-50", etc.
    logo_key   String?  @db.VarChar(512) // object-store key
    created_at DateTime @default(now()) @db.Timestamptz
    updated_at DateTime @updatedAt @db.Timestamptz

    recruiters RecruiterProfile[]
    jobs       Job[]

    @@index([name])
    @@map("companies")
}

// ---------------------------------------------------------------------------
// JOB POSTING
// ---------------------------------------------------------------------------

model Job {
    id               String          @id @default(uuid()) @db.Uuid
    recruiter_id         String          @db.Uuid
    company_id           String          @db.Uuid
    title                String          @db.VarChar(200)
    description          String // markdown — full job post body
    requirements         String // role requirements (used for AI matching)
    qualifications       String? // nice-to-haves
    responsibilities     String?
    location             String?         @db.VarChar(200)
    job_type             JobType         @default(FULL_TIME)
    experience_level     ExperienceLevel @default(MID)
    salary_min           Decimal?        @db.Decimal(12, 2)
    salary_max           Decimal?        @db.Decimal(12, 2)
    salary_currency      String          @default("USD") @db.VarChar(3)
    status               JobStatus       @default(DRAFT)
    slug                 String          @unique @db.VarChar(300)
    deadline             DateTime?       @db.Timestamptz
    published_at         DateTime?       @db.Timestamptz
    screening_questions  String? // newline-separated list pasted by recruiter
    created_at           DateTime        @default(now()) @db.Timestamptz
    updated_at           DateTime        @updatedAt @db.Timestamptz
    deleted_at           DateTime?       @db.Timestamptz // soft delete

    recruiter    RecruiterProfile @relation(fields: [recruiter_id], references: [id])
    company      Company          @relation(fields: [company_id], references: [id])
    applications Application[]
    interviews   Interview[]

    @@index([status])
    @@index([recruiter_id])
    @@index([company_id])
    @@index([deadline])
    @@index([deleted_at])
    // Full-text search index (managed via raw migration)
    // CREATE INDEX jobs_fts_idx ON jobs USING GIN (to_tsvector('english', title || ' ' || description));
    @@map("jobs")
}

// ---------------------------------------------------------------------------
// APPLICATION — one row per (applicant, job) pair; unique constraint enforced
// Match score calculated at application time (not at CV upload).
// ---------------------------------------------------------------------------

model Application {
    id               String            @id @default(uuid()) @db.Uuid
    applicant_id     String            @db.Uuid
    job_id           String            @db.Uuid
    status           ApplicationStatus @default(APPLIED)
    match_score      Decimal?          @db.Decimal(5, 2) // 0.00 – 100.00
    match_details    Json? // breakdown: skills%, exp%, edu%
    rank             Int? // computed rank among applicants for this job
    applied_at       DateTime          @default(now()) @db.Timestamptz
    updated_at       DateTime          @updatedAt @db.Timestamptz
    reviewed_at      DateTime?         @db.Timestamptz // when recruiter acted
    rejection_reason String?           @db.VarChar(500)

    applicant ApplicantProfile @relation(fields: [applicant_id], references: [id])
    job       Job              @relation(fields: [job_id], references: [id])
    interview Interview?

    // Enforce one application per (applicant, job)
    @@unique([applicant_id, job_id])
    @@index([job_id, match_score(sort: Desc)]) // recruiter ranked list
    @@index([applicant_id, status])
    @@index([status])
    @@map("applications")
}

// ---------------------------------------------------------------------------
// INTERVIEW — one per application; created when recruiter promotes to interview
// ---------------------------------------------------------------------------

model Interview {
    id             String          @id @default(uuid()) @db.Uuid
    application_id String          @unique @db.Uuid // one interview per application
    job_id         String          @db.Uuid // denormalized for easy querying
    access_token   String          @unique @db.VarChar(256) // signed token in link
    status         InterviewStatus @default(PENDING)
    scheduled_at   DateTime?       @db.Timestamptz
    started_at     DateTime?       @db.Timestamptz
    completed_at   DateTime?       @db.Timestamptz
    expires_at              DateTime             @db.Timestamptz // deadline + 24h
    video_key               String?              @db.VarChar(512) // object-store key for recorded video
    video_recording_status  VideoRecordingStatus @default(NOT_STARTED)
    created_at              DateTime             @default(now()) @db.Timestamptz
    updated_at              DateTime             @updatedAt @db.Timestamptz

    application Application         @relation(fields: [application_id], references: [id])
    job         Job                 @relation(fields: [job_id], references: [id])
    questions   InterviewQuestion[]
    report      EvaluationReport?

    @@index([job_id])
    @@index([status])
    @@index([expires_at])
    @@map("interviews")
}

// ---------------------------------------------------------------------------
// INTERVIEW QUESTION — AI-generated questions stored per interview
// Storing per-question enables per-question scoring and transcript replay.
// ---------------------------------------------------------------------------

model InterviewQuestion {
    id              String    @id @default(uuid()) @db.Uuid
    interview_id    String    @db.Uuid
    sequence        Int // 1-based order of question
    question_text   String
    question_type   String    @default("OPEN") @db.VarChar(50) // OPEN|TECHNICAL|BEHAVIORAL
    transcript      String? // candidate's spoken answer (STT output)
    audio_key       String?   @db.VarChar(512) // object-store key for audio file
    score           Decimal?  @db.Decimal(4, 1) // 0.0 – 10.0 (immutable once set)
    score_rationale String? // AI explanation for the score
    asked_at        DateTime? @db.Timestamptz
    answered_at     DateTime? @db.Timestamptz

    interview Interview @relation(fields: [interview_id], references: [id], onDelete: Cascade)

    @@unique([interview_id, sequence])
    @@index([interview_id])
    @@map("interview_questions")
}

// ---------------------------------------------------------------------------
// EVALUATION REPORT — generated once after interview completes; immutable
// ---------------------------------------------------------------------------

model EvaluationReport {
    id                String   @id @default(uuid()) @db.Uuid
    interview_id      String   @unique @db.Uuid
    overall_score     Decimal  @db.Decimal(5, 2) // 0.00 – 100.00 (immutable)
    percentile_rank   Decimal? @db.Decimal(5, 2) // vs other applicants
    pass_fail         Boolean // true = pass
    strengths         String[] // AI-extracted strengths
    weaknesses        String[] // AI-extracted weaknesses
    ai_recommendation String // AI suitability narrative
    full_report_json  Json // complete structured report
    pdf_key           String?  @db.VarChar(512) // generated PDF in object store
    generated_at      DateTime @default(now()) @db.Timestamptz

    interview Interview @relation(fields: [interview_id], references: [id], onDelete: Cascade)

    @@index([interview_id])
    @@map("evaluation_reports")
}

// ---------------------------------------------------------------------------
// AUDIT LOG — append-only; never updated or deleted
// Satisfies the security requirement for audit logging.
// ---------------------------------------------------------------------------

model AuditLog {
    id          String      @id @default(uuid()) @db.Uuid
    user_id     String?     @db.Uuid // null for system actions
    action      AuditAction
    entity      String      @db.VarChar(100) // table name
    entity_id   String?     @db.VarChar(100) // affected row id
    old_values  Json? // snapshot before change
    new_values  Json? // snapshot after change
    ip_address  String?     @db.Inet
    user_agent  String?     @db.VarChar(512)
    occurred_at DateTime    @default(now()) @db.Timestamptz

    user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

    @@index([user_id])
    @@index([entity, entity_id])
    @@index([occurred_at])
    @@index([action])
    @@map("audit_logs")
}
