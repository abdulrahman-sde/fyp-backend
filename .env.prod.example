# Copy to .env.prod and fill values

# Comma-separated list of allowed frontend origins (recommended)
FRONTEND_ORIGINS=https://fyp-candidate-frontend-a3okr93xi.vercel.app,https://fyp-reccruiter-frontend.vercel.app

# Back-compat: single origin (optional)
# FRONTEND_ORIGIN=https://app.yourdomain.com
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=production

DATABASE_URL=postgresql://USER:PASSWORD@RDS_HOST:5432/DB_NAME?schema=public

GROQ_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
RESEND_API_KEY=

CLOUDINARY_URL=

LIVEKIT_URL=wss://livekit.yourdomain.com
LIVEKIT_PUBLIC_URL=wss://livekit.yourdomain.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

AGENT_WEBHOOK_SECRET=replace-with-agent-secret
